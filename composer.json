{
    "name": "setono/sylius-terms-plugin",
    "description": "Sylius terms and conditions plugin",
    "license": "MIT",
    "type": "sylius-plugin",
    "keywords": [
        "sylius",
        "sylius-plugin",
        "terms"
    ],
    "require": {
        "php": ">=8.2",
        "doctrine/collections": "^2.2",
        "doctrine/orm": "^2.18 || ^3.5",
        "doctrine/persistence": "^3.3",
        "fakerphp/faker": "^1.23",
        "knplabs/knp-menu": "^3.5",
        "league/commonmark": "^2.10.2",
        "masterminds/html5": "^2.7.2",
        "psr/cache": "^2.0 || ^3.0",
        "psr/clock": "^1.0",
        "psr/log": "^1.1 || ^2.0 || ^3.0",
        "setono/doctrine-orm-trait": "^1.2",
        "sylius/channel": "^2.2",
        "sylius/channel-bundle": "^2.2",
        "sylius/core": "^2.2",
        "sylius/core-bundle": "^2.2",
        "sylius/grid-bundle": "^1.16",
        "sylius/locale": "^2.2",
        "sylius/mailer-bundle": "^2.1",
        "sylius/resource-bundle": "^1.12",
        "sylius/shop-bundle": "^2.2",
        "sylius/ui-bundle": "^2.2",
        "symfony/clock": "^6.4 || ^7.4",
        "symfony/config": "^6.4 || ^7.4",
        "symfony/console": "^6.4 || ^7.4",
        "symfony/dependency-injection": "^6.4 || ^7.4",
        "symfony/event-dispatcher": "^6.4 || ^7.4",
        "symfony/event-dispatcher-contracts": "^3.4",
        "symfony/form": "^6.4 || ^7.4",
        "symfony/html-sanitizer": "^6.4.50 || ^7.4.23",
        "symfony/http-client-contracts": "^3.4",
        "symfony/http-foundation": "^6.4 || ^7.4",
        "symfony/http-kernel": "^6.4 || ^7.4",
        "symfony/mime": "^6.4.49 || ^7.4.22",
        "symfony/options-resolver": "^6.4 || ^7.4",
        "symfony/routing": "^6.4 || ^7.4",
        "symfony/service-contracts": "^3.4",
        "symfony/string": "^6.4 || ^7.4",
        "symfony/ux-live-component": "^2.25",
        "symfony/ux-twig-component": "^2.25",
        "symfony/validator": "^6.4 || ^7.4",
        "twig/intl-extra": "^3.26",
        "twig/twig": "^3.27",
        "webmozart/assert": "^1.11"
    },
    "require-dev": {
        "api-platform/symfony": "^4.3.3",
        "dama/doctrine-test-bundle": "^8.6",
        "dompdf/dompdf": "^3.1.6",
        "gedmo/doctrine-extensions": "^3.22.2",
        "payum/core": "^1.7.5",
        "playwright-php/playwright": "^1.6",
        "playwright-php/playwright-symfony": "^0.12",
        "setono/sylius-plugin": "^2.0",
        "sylius/pdf-generation-bundle": "^1.0",
        "sylius/sylius": "~2.2.12",
        "symfony/css-selector": "^6.4 || ^7.4",
        "symfony/debug-bundle": "^6.4 || ^7.4",
        "symfony/dotenv": "^6.4 || ^7.4",
        "symfony/http-client": "^6.4.50 || ^7.4.23",
        "symfony/intl": "^6.4 || ^7.4",
        "symfony/property-info": "^6.4 || ^7.4",
        "symfony/serializer": "^6.4 || ^7.4",
        "symfony/web-profiler-bundle": "^6.4 || ^7.4",
        "symfony/webpack-encore-bundle": "^2.2"
    },
    "suggest": {
        "dompdf/dompdf": "The default engine of the Terms PDFs attached to the order confirmation email (setono_sylius_terms.order_confirmation_email.pdf)",
        "sylius/pdf-generation-bundle": "Renders the Terms PDFs attached to the order confirmation email (setono_sylius_terms.order_confirmation_email.pdf)",
        "symfony/http-client": "Downloads the images in the Terms PDFs attached to the order confirmation email (setono_sylius_terms.order_confirmation_email.pdf)"
    },
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Setono\\SyliusTermsPlugin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Setono\\SyliusTermsPlugin\\Tests\\": "tests/",
            "Setono\\SyliusTermsPlugin\\Tests\\Application\\": "tests/Application/src/"
        },
        "classmap": [
            "tests/Application/Kernel.php"
        ]
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": false,
            "ergebnis/composer-normalize": true,
            "infection/extension-installer": true,
            "php-http/discovery": false,
            "phpstan/extension-installer": true,
            "symfony/thanks": false
        },
        "sort-packages": true
    },
    "scripts": {
        "analyse": "phpstan analyse",
        "check-style": "ecs check",
        "fix-style": "ecs check --fix",
        "phpunit": "phpunit",
        "phpunit:browser": "phpunit --testsuite browser",
        "phpunit:functional": "phpunit --testsuite functional",
        "phpunit:unit": "phpunit --testsuite unit"
    }
}
