<?xml version="1.0" encoding="UTF-8"?>

<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:gedmo="http://gediminasm.org/schemas/orm/doctrine-extensions-mapping"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <mapped-superclass name="Setono\SyliusTermsPlugin\Model\Terms" table="setono_sylius_terms__terms">
        <id name="id" column="id" type="integer">
            <generator strategy="AUTO"/>
        </id>

        <field name="code" type="string" column="code" unique="true"/>
        <field name="enabled" type="boolean"/>

        <!-- The database default fills existing rows with true when an app adds the column, see docs/adr/0008 -->
        <field name="required" type="boolean">
            <options>
                <option name="default">1</option>
            </options>
        </field>

        <field name="position" type="integer">
            <gedmo:sortable-position/>
        </field>

        <!-- The codes of the Forms the Terms is placed on -->
        <field name="forms" type="json" nullable="true"/>

        <field name="createdAt" column="created_at" type="datetime">
            <gedmo:timestampable on="create"/>
        </field>

        <field name="updatedAt" column="updated_at" type="datetime" nullable="true">
            <gedmo:timestampable on="update"/>
        </field>

        <many-to-many field="channels" target-entity="Sylius\Component\Channel\Model\ChannelInterface">
            <join-table name="setono_sylius_terms__terms_channels">
                <join-columns>
                    <join-column name="terms_id" referenced-column-name="id" nullable="false" on-delete="CASCADE"/>
                </join-columns>
                <inverse-join-columns>
                    <join-column name="channel_id" referenced-column-name="id" nullable="false" on-delete="CASCADE"/>
                </inverse-join-columns>
            </join-table>
        </many-to-many>

        <!-- The database deletes a Terms' versions with the Terms (terms_id ON DELETE CASCADE in TermsVersion.orm.xml) -->
        <one-to-many field="versions" target-entity="Setono\SyliusTermsPlugin\Model\TermsVersionInterface" mapped-by="terms">
            <cascade>
                <cascade-persist/>
            </cascade>
            <order-by>
                <order-by-field name="number" direction="ASC"/>
            </order-by>
        </one-to-many>
    </mapped-superclass>
</doctrine-mapping>
