<?xml version="1.0" encoding="UTF-8"?>

<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <mapped-superclass name="Setono\SyliusTermsPlugin\Model\TermsVersion" table="setono_sylius_terms__terms_version">
        <id name="id" column="id" type="integer">
            <generator strategy="AUTO"/>
        </id>

        <field name="number" type="integer"/>
        <field name="inForceFrom" column="in_force_from" type="datetime_immutable"/>

        <many-to-one field="terms" target-entity="Setono\SyliusTermsPlugin\Model\TermsInterface" inversed-by="versions">
            <join-column name="terms_id" referenced-column-name="id" nullable="false" on-delete="CASCADE"/>
        </many-to-one>

        <unique-constraints>
            <unique-constraint columns="terms_id,number" name="setono_sylius_terms__terms_version_uniq_number"/>
        </unique-constraints>
    </mapped-superclass>
</doctrine-mapping>
